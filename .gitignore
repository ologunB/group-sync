# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
dist/

# ── Environment variables ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Provider credential downloads ─────────────────────────────────────────────
# Google's OAuth JSON download contains a live client_secret. The ID-token flow does
# not need it (only GOOGLE_CLIENT_ID, which lives in .env), so these files should
# never reach the repo.
client_secret*.json
*.apps.googleusercontent.com.json
AuthKey_*.p8

# ── Prisma generated client ───────────────────────────────────────────────────
prisma/generated/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

# ── IDEs ─────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── Test / coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.tsbuildinfo
