model User {
  id                   String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String                                @unique @db.VarChar(255)
  phone                String?
  phoneIv              String?                               @map("phone_iv")
  phoneHash            String?                               @unique @map("phone_hash")
  passwordHash         String?                               @map("password_hash")
  displayName          String                                @map("display_name") @db.VarChar(100)
  username             String?                               @unique @db.VarChar(50)
  profilePhotoUrl      String?                               @map("profile_photo_url")
  bio                  String?
  city                 String?                               @db.VarChar(100)
  state                String?                               @db.VarChar(100)
  country              String?                               @default("NG") @db.VarChar(100)
  location             Unsupported("geometry(Point, 4326)")?
  interests            String[]                              @default([]) @db.Text
  emailVerifiedAt      DateTime?                             @map("email_verified_at") @db.Timestamptz
  idVerificationStatus String                                @default("unsubmitted") @map("id_verification_status") @db.VarChar(20)
  idDocumentUrl        String?                               @map("id_document_url")
  idDocumentIv         String?                               @map("id_document_iv")
  idVerifiedAt         DateTime?                             @map("id_verified_at") @db.Timestamptz
  status               String                                @default("active") @db.VarChar(20)
  role                 String                                @default("user") @db.VarChar(30)
  lastLoginAt          DateTime?                             @map("last_login_at") @db.Timestamptz
  preferredLanguage    String?                               @default("en") @map("preferred_language") @db.VarChar(10)
  createdAt            DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                              @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?                             @map("deleted_at") @db.Timestamptz

  refreshTokens        RefreshToken[]
  sessions             Session[]
  auditLogs            AuditLog[]
  providers            UserProvider[]
  blocksGiven          UserBlock[]    @relation("BlockerRelation")
  blocksReceived       UserBlock[]    @relation("BlockedRelation")
  groupsCreated        Group[]        @relation("GroupCreator")
  memberships          Membership[]
  applications         Application[]  @relation("ApplicationUser")
  applicationsReviewed Application[]  @relation("ApplicationReviewer")
  inviteLinksCreated   InviteLink[]              @relation("InviteLinkCreator")
  eventsCreated        Event[]                   @relation("EventCreator")
  eventRsvps           EventRsvp[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  reportsGiven         Report[]                  @relation("ReporterRelation")
  reportsReviewed      Report[]                  @relation("ReviewerRelation")
  messagesSent         Message[]                 @relation("MessageSender")
  messageReactions     MessageReaction[]
  directMessagesSent   DirectMessage[]           @relation("DMSender")
  directMessagesRecv   DirectMessage[]           @relation("DMReceiver")
  chatReadReceipts     ChatReadReceipt[]

  @@index([role],   map: "idx_users_role")
  @@index([status], map: "idx_users_status")
  @@index([idVerificationStatus], map: "idx_users_verification")
  @@index([email], map: "idx_users_email")
  @@map("users")
}

model UserProvider {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  provider   String   @db.VarChar(30)
  providerId String   @map("provider_id")
  email      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId], map: "idx_providers_user")
  @@map("user_providers")
}

model UserBlock {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blocker User @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId], map: "idx_blocks_blocker")
  @@index([blockedId], map: "idx_blocks_blocked")
  @@map("user_blocks")
}

// ─── Report ───────────────────────────────────────────────────────────────────

model Report {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId  String    @map("reporter_id") @db.Uuid
  targetType  String    @map("target_type") @db.VarChar(20)
  targetId    String    @map("target_id") @db.Uuid
  reason      String    @db.VarChar(80)
  description String?
  status      String    @default("open") @db.VarChar(20)
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  reporter User  @relation("ReporterRelation", fields: [reporterId], references: [id])
  reviewer User? @relation("ReviewerRelation", fields: [reviewedBy], references: [id])

  @@index([status, createdAt], map: "idx_reports_status")
  @@index([targetType, targetId], map: "idx_reports_target")
  @@map("reports")
}
