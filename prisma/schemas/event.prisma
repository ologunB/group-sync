// ─── Event ────────────────────────────────────────────────────────────────────

model Event {
  id           String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String                                @map("group_id") @db.Uuid
  createdBy    String?                               @map("created_by") @db.Uuid
  title        String                                @db.VarChar(200)
  description  String?
  locationName String?                               @map("location_name") @db.VarChar(255)
  // Venue is split by audience. venueCity/venueState render the public "Ibadan, Oyo"
  // area label anyone can use to judge distance; venueAddress is the exact street
  // address and is only ever serialised for active members of the group.
  venueCity    String?                               @map("venue_city") @db.VarChar(100)
  venueState   String?                               @map("venue_state") @db.VarChar(100)
  venueAddress String?                               @map("venue_address")
  locationPoint Unsupported("geometry(Point, 4326)")? @map("location_point")
  startsAt     DateTime                              @map("starts_at") @db.Timestamptz
  endsAt       DateTime?                             @map("ends_at") @db.Timestamptz
  rsvpLimit    Int?                                  @map("rsvp_limit")
  rsvpCount    Int                                   @default(0) @map("rsvp_count")
  status       String                                @default("scheduled") @db.VarChar(20) @map("status")
  // 'private' (default) — visible to active group members only.
  // 'public'  — also visible to non-members in the group's event preview.
  visibility   String                                @default("private") @db.VarChar(20) @map("visibility")
  createdAt    DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                              @updatedAt @map("updated_at") @db.Timestamptz

  group   Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User?       @relation("EventCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  rsvps   EventRsvp[]

  @@index([groupId, startsAt], map: "idx_events_group_starts")
  @@index([groupId, visibility, startsAt], map: "idx_events_group_visibility_starts")
  @@map("events")
}

// ─── EventRsvp ────────────────────────────────────────────────────────────────

model EventRsvp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("going") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId], map: "idx_rsvps_event")
  @@index([userId], map: "idx_rsvps_user")
  @@map("event_rsvps")
}
