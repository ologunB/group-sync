// ─── Event ────────────────────────────────────────────────────────────────────

model Event {
  id           String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String                                @map("group_id") @db.Uuid
  createdBy    String                                @map("created_by") @db.Uuid
  title        String                                @db.VarChar(200)
  description  String?
  locationName String?                               @map("location_name") @db.VarChar(255)
  locationPoint Unsupported("geometry(Point, 4326)")? @map("location_point")
  startsAt     DateTime                              @map("starts_at") @db.Timestamptz
  endsAt       DateTime?                             @map("ends_at") @db.Timestamptz
  rsvpLimit    Int?                                  @map("rsvp_limit")
  rsvpCount    Int                                   @default(0) @map("rsvp_count")
  status       String                                @default("scheduled") @db.VarChar(20) @map("status")
  createdAt    DateTime                              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime                              @updatedAt @map("updated_at") @db.Timestamptz

  group   Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User        @relation("EventCreator", fields: [createdBy], references: [id])
  rsvps   EventRsvp[]

  @@index([groupId, startsAt], map: "idx_events_group_starts")
  @@map("events")
}

// ─── EventRsvp ────────────────────────────────────────────────────────────────

model EventRsvp {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId   String   @map("event_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  status    String   @default("going") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId], map: "idx_rsvps_event")
  @@index([userId], map: "idx_rsvps_user")
  @@map("event_rsvps")
}
